{
  "name": "@area44/biome-config",
  "version": "2.3.4",
  "description": "AREA44's Biome configuration",
  "author": "AREA44 (https://github.com/area44)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/area44/biome-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/area44/biome-config.git"
  },
  "keywords": [
    "biome",
    "biome-config",
    "biome-plugin",
    "linter",
    "formatter"
  ],
  "files": [
    "biome-manifest.json",
    "configs"
  ],
  "exports": {
    "biome": "./biome-manifest.json"
  },
  "scripts": {
    "check": "biome ci .",
    "fix": "biome check --write",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.6.2 <3"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
