{
  "files": {
    "includes": [
      "**",
      "!**/*.min.*",
      "!**/*.map",
      "!**/build",
      "!**/build/**",
      "!**/dist",
      "!**/dist/**",
      "!**/out",
      "!**/out/**",
      "!**/public",
      "!**/public/**",
      "!**/.astro",
      "!**/.astro/**",
      "!**/.next",
      "!**/.next/**",
      "!**/.netlify",
      "!**/.netlify/**",
      "!**/.output",
      "!**/.output/**",
      "!**/.svelte-kit",
      "!**/.svelte-kit/**",
      "!**/coverage",
      "!**/coverage/**",
      "!**/.turbo",
      "!**/.turbo/**"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
